{
	id: '0ea2d0aa-750b-439c-b3ca-7351b95cdad8',

	name: 'AMIXOF Light',
	author: 'AMIXOF',
	desc: 'AMIXOF default light theme: layered neutral surfaces with the coral-red brand accent',

	base: 'light',

	props: {
		// Brand red is used for text-on-white accents (4.2:1 on white); coral stays for indicators and focus.
		accent: '@brandRed',
		accentedBg: ':alpha<0.12<@brandCoral',
		focus: ':alpha<0.35<@brandCoral',
		indicator: '@brandCoral',
		// Surfaces: page / feed / secondary
		bg: '#FAF8FA',
		panel: '#FFFFFF',
		panelHighlight: '#F4F1F6',
		panelHeaderBg: '#FFFFFF',
		navBg: '#FFFFFF',
		buttonBg: '#F4F1F6',
		buttonHoverBg: ':darken<4<#F4F1F6',
		buttonGradateA: '@brandRed',
		buttonGradateB: '@brandCoral',
		fg: '#352E39',
		fgOnWhite: '@brandRed',
		divider: '#ECE7EE',
		love: '@brandRed',
		mentionMe: '@brandDeepRed',
	},
}
