		// Surfaces: page / feed / secondary
		bg: '#100D12',
		panel: '#161219',
		panelHighlight: '#211B26',
		panelHeaderBg: '#161219',
		navBg: '#161219',
		buttonBg: '#211B26',
		buttonHoverBg: ':lighten<4<#211B26',
		buttonGradateA: '@brandCoral',
		buttonGradateB: '@brandPink',
		fg: '#D9D0DC',
		fgHighlighted: '#F6F2F7',
		fgOnWhite: '@brandRed',
		divider: '#302735',
		love: '@brandPink',
		mentionMe: '@brandPink',
	},
}
