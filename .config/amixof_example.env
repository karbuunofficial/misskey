# AMIXOF development environment.
#
# Copy this file to .config/amixof.env (untracked, see .gitignore) and fill in
# the values. .devcontainer/init.sh does this automatically on first run and
# generates a random DATABASE_PASSWORD. The devcontainer loads
# .config/amixof.env into the app container (compose `env_file`) and into
# interactive shells, and Misskey's config loader reads DATABASE_DB /
# DATABASE_USER / DATABASE_PASSWORD when .config/default.yml omits db.db /
# db.user / db.pass.
#
# Never commit the real .config/amixof.env.

# Application database (dedicated least-privilege role; owner of its own database only)
DATABASE_DB=amixof
DATABASE_USER=amixof
DATABASE_PASSWORD=

# Password of the `postgres` superuser of the compose `db` service. Used only by
# init.sh to provision the role/database above. Defaults to the value set in
# .devcontainer/compose.yml when left empty.
POSTGRES_SUPERUSER_PASSWORD=
